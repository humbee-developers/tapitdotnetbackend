{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tapitai;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpiryMinutes": 60
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-TO-A-STRONG-SECRET-KEY-AT-LEAST-32-CHARS",
    "Issuer": "TapitAI",
    "Audience": "TapitAI",
    "ExpirationInMinutes": 60
  },
  "Auth0": {
    "Domain": "your-tenant.auth0.com",
    "Audience": "https://api.tapitai.com"
  },
  "Storage": {
    "ActiveProvider": "S3",
    "S3": {
      "AccessKey": "YOUR_AWS_ACCESS_KEY",
      "SecretKey": "YOUR_AWS_SECRET_KEY",
      "BucketName": "your-bucket-name",
      "Region": "us-east-1",
      "BaseUrl": null
    },
    "Cloudinary": {
      "CloudName": "your-cloud-name",
      "ApiKey": "your-api-key",
      "ApiSecret": "your-api-secret"
    },
    "GoogleStorage": {
      "ProjectId": "your-gcp-project-id",
      "BucketName": "your-gcs-bucket",
      "CredentialsPath": null
    }
  },
  "GetStream": {
    "ApiKey": "your-getstream-api-key",
    "ApiSecret": "your-getstream-api-secret"
  },
  "AdminCredentials": {
    "DefaultEmail": "admin@tapitai.com",
    "DefaultPassword": "Admin@123456"
  }
}
